# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# daycare data cache
.cache/

# DART 수집기 산출물
# 원격 컨테이너는 회수되면 사라지므로, 요구사항("raw 원본 삭제 금지")을 지키려면
# raw/ 를 압축해 커밋해야 한다. emit 이 raw/ 의 순수 함수라 raw.tar.gz 하나면
# text/·XLSX 를 포함한 전 산출물을 네트워크·API 키 없이 복원할 수 있다.
/dart_out/text/
/dart_out/*.xlsx
/dart_out/raw/
/dart_out/*.log
/dart_out/corp_code_overrides.csv

# python (scripts/dart 수집기)
__pycache__/
*.py[cod]

# 큰 CSV 는 .gz 만 커밋 (동일 내용 중복 방지)
/dart_out/11_원문추출.csv
/dart_out/03b_재무제표_long.csv
/dart_out/03_재무제표.csv
/dart_out/02_공시목록.csv
/dart_out/00_계정과목목록.csv

# 분석 핸드오프 키트 — zip 하나만 커밋한다 (34MB → 1.5MB, 개별 CSV 는 중복)
/handoff/*
!/handoff/dart-benchmark-kit.zip
# 정관·이사회의사록·평가의견서 + 설립 원본 4건의 본문 (100파일 60MB).
# 나머지 원본·첨부 535MB(감사보고서·예비투자설명서·본문 HTML)는 커밋하지 않는다 —
# handoff/원문_파일목록.csv 에 dcmNo·source_url 이 다 있어 `run.py dartweb` 으로
# 언제든 다시 받을 수 있다(853요청·약 26분, 캐시 있으면 그만큼 건너뛴다).
# 3차에서 종류별·90MB 예산으로 다시 나눴다(GitHub 파일당 100MB 한도).
!/handoff/원본_정관_평가의견.zip
!/handoff/원본_이사회의사록_1.zip
!/handoff/원본_이사회의사록_2.zip
!/handoff/원본_주요신고서본문.zip

# 5차(지주 조직 운영) 산출물 — 작고 핵심이라 그대로 커밋한다(합계 약 9 MB).
# 큰 표 CSV(조직운영_표_5차 258MB)는 기존 규약대로 키트 zip 으로만 인계한다.
!/handoff/임원현황.csv
!/handoff/직원현황.csv
!/handoff/겸직현황_정리.csv
!/handoff/위원회현황.csv
!/handoff/임원_겸직_결합.csv
!/handoff/지주_자회사_임원명부교집합.csv
!/handoff/설립첫해_임원구성.csv

# 6차(지배구조 연차보고서) — 파일목록만 커밋한다. 섹션 40MB·주제 83MB·표 893MB 는
# raw/governance 와 코드로 언제든 재생성된다(`governance_emit.py`, 약 50분).
!/handoff/연차보고서_파일목록.csv

# selftest 임시 산출물
/dart_out/_selftest/

# 웹 원본·첨부 수집 결과 — doc.tar.gz 만 커밋한다 (PDF 수백 MB)
/dart_out/doc/

# dart selftest scratch (run.py selftest 를 scripts/dart 안에서 돌리면 생긴다)
scripts/dart/dart_out/
